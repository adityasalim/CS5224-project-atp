{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "ApiKeys", "Effect": "Allow", "Action": "secretsmanager:GetSecretValue",
     "Resource": "arn:aws:secretsmanager:ap-southeast-1:<account-id>:secret:tp/dev/api-keys-*"},
    {"Sid": "Tables", "Effect": "Allow",
     "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:Query", "dynamodb:UpdateItem",
                "dynamodb:BatchGetItem", "dynamodb:BatchWriteItem"],
     "Resource": "arn:aws:dynamodb:ap-southeast-1:<account-id>:table/tp-dev-*"},
    {"Sid": "Pdfs", "Effect": "Allow", "Action": ["s3:PutObject", "s3:GetObject"],
     "Resource": "arn:aws:s3:::tp-dev-plans-<suffix>/*"},
    {"Sid": "Location", "Effect": "Allow", "Action": ["geo-places:*", "geo-routes:*"], "Resource": "*"}
  ]
}
